# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Clerk (admin auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/admin/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/admin/sign-up"

# --- UploadThing ---
UPLOADTHING_TOKEN=""

# --- WhatsApp / Contact ---
NEXT_PUBLIC_WHATSAPP_NUMBER="528000000000"
CONTACT_NOTIFY_EMAIL="contacto@sibradgo.com"
# Opcional: si se define, cada contacto se reenvía vía POST a este webhook
# (Zapier / Make / n8n / Slack incoming webhook). Sin definir = solo se guarda en DB.
CONTACT_WEBHOOK_URL=""

# --- Stripe (checkout — opcional, inactivo hasta configurar) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://sibradgo.com"
